# Rafiq — IdeaMap's AI engine — mixes whichever of these free providers you
# configure. IdeaMap is a free tool for Moroccan youth: every provider Rafiq
# talks to has a genuinely free, no-card-required tier. There is no paid AI
# provider in this codebase. See app/api/ai/providers.ts.

# Google Gemini — free tier, preferred for structured JSON steps (profile, plan,
# budget, compliance) via its native structured-output mode.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash

# Groq — free tier, preferred for the short conversational dialogue questions.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=...
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter — free-tier models, a third free fallback for either step type.
# Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=...
# OPENROUTER_MODEL=qwen/qwen3-235b-a22b:free
