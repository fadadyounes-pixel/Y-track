# Rafiq — IdeaMap's AI engine — mixes whichever of these providers you configure.
# You only need one to run the app, but having two or three makes Rafiq fall back
# automatically if a provider is rate-limited or down. See app/api/ai/providers.ts.

# Anthropic Claude — tried first when set (best quality we've measured).
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5

# Google Gemini — free tier, preferred for structured JSON steps (profile, plan,
# budget, compliance). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Groq — free tier, preferred for the short conversational dialogue questions.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=...
